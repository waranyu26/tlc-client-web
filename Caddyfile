# Railway terminates TLS at its edge and forwards plain HTTP to $PORT, so this
# site address is a bare port with no hostname. That form also switches Caddy's
# automatic HTTPS off, which is what we want here: a certificate at this layer
# would be both redundant and unobtainable.
:{$PORT:8080} {
	root * /srv
	encode gzip zstd

	# Vite emits content-hashed filenames under /assets, so those are safe to
	# cache forever. Everything else — index.html above all — must revalidate:
	# index.html is the document that names the current asset hashes, and a
	# stale copy pins visitors to files that no longer exist after a deploy.
	#
	# This is expressed as "not /assets/*" rather than a rule on /index.html
	# because `header` runs BEFORE `try_files` in Caddy's directive order, so a
	# path matcher here only ever sees the request's original path — /vault,
	# never the /index.html it is about to be rewritten to.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@dynamic not path /assets/*
	header @dynamic Cache-Control "no-cache"

	# Single-page app: any path the filesystem does not have must return
	# index.html so the client router can resolve it. Without this, a direct
	# hit or a refresh on a client route 404s — including
	# /auth/callback/google, the Google OAuth redirect target, which would
	# break social sign-in on exactly the return leg.
	try_files {path} /index.html
	file_server
}
